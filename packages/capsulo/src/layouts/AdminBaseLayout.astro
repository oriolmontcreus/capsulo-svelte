---
import "../styles/admin.css";
import ModeWatcherClient from "../lib/components/ModeWatcherClient.svelte";
import { ClientRouter } from "astro:transitions";
import { BUILD_UI_LOCALE } from "../lib/admin-i18n/core";

interface Props {
	title?: string;
	fontFamily?: "sans" | "geist";
}

// The admin's own html shell: the site's layout and styles never reach the admin.
const { title = "Capsulo", fontFamily = "sans" } = Astro.props as Props;
---

<!doctype html>
<html lang={BUILD_UI_LOCALE} class={fontFamily === "geist" ? "font-geist" : "font-sans"} transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter fallback="swap" />
		<script is:inline>
			(function() {
				function applyMode(rootEl) {
					try {
						const mode = localStorage.getItem("mode-watcher-mode") || "system";
						const light = mode === "light" || (mode === "system" && window.matchMedia("(prefers-color-scheme: light)").matches);
						if (light) {
							rootEl.classList.remove("dark");
						} else {
							rootEl.classList.add("dark");
						}
						rootEl.style.colorScheme = light ? "light" : "dark";
					} catch (e) {}
				}
				applyMode(document.documentElement);
				// Set the mode on the incoming document before the router copies its <html>
				// attributes over. Re-adding it after the swap leaves a window where the page
				// is styled as light, and anything with a color transition fades in from white.
				document.addEventListener("astro:before-swap", (event) => applyMode(event.newDocument.documentElement));
			})();
		</script>
	</head>
	<body>
		<slot />
		<ModeWatcherClient client:load transition:persist="mode-watcher" />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
