{
  "name": "capsulo",
  "version": "0.1.0",
  "description": "Capsulo: the Astro integration (admin, CMS API) and the CLI for users, content pulls and Cloudflare deploys.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astro-integration",
    "cms"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "capsulo": "./bin/capsulo.js"
  },
  "exports": {
    "./astro": {
      "types": "./src/integration/index.ts",
      "default": "./dist/astro.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.js"
    },
    "./schema": "./src/schema.ts",
    "./runtime": "./src/runtime.ts",
    "./components/*": "./src/components/*",
    "./client": {
      "types": "./src/types/client.d.ts"
    },
    "./password": {
      "types": "./src/password.d.ts",
      "default": "./src/password.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "cli",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "node scripts/build.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@cloudflare/workers-types": "5.20260924.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.17.0",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "marked": "^18.0.14",
    "microdiff": "^1.5.0",
    "mode-watcher": "1.1.0",
    "ogl": "^1.0.11",
    "shadcn-svelte": "^1.2.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.3.5",
    "svelte": "^5.55.5",
    "tailwindcss": "^4.2.4",
    "vite": "^8.3.1",
    "wrangler": "^4.140.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.3.5",
    "esbuild": "^0.28.2",
    "svelte": "^5.55.5",
    "tailwindcss": "^4.2.4",
    "vite": "^8.3.1",
    "wrangler": "4.140.0"
  }
}
