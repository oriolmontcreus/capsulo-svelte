{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "packages/capsulo/src/lib/components/ui/dropdown-menu/**",
    "templates/**"
  ],
  "entry": [
    "capsulo.config.ts",
    "svelte.config.js",
    "src/components/capsules/**/capsule.definition.ts",
    "src/config/**/*.ts",
    "packages/capsulo/src/integration/index.ts",
    "packages/capsulo/src/schema.ts",
    "packages/capsulo/src/runtime.ts",
    "packages/capsulo/src/lib/form-builder/demo/**/*.{ts,svelte}",
    "packages/capsulo/src/lib/form-builder/core/schema-to-zod.ts",
    "packages/capsulo/src/lib/form-builder/schemas/**/*.ts"
  ],
  "ignoreExports": [
    {
      "file": "src/lib/components/ui/**/index.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "packages/capsulo/src/lib/components/ui/**/index.ts",
      "exports": [
        "*"
      ]
    }
  ],
  "ignoreExportsUsedInFile": {
    "type": true,
    "interface": true
  },
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {}
}
