---
import { File as FileIcon } from '@lucide/astro';

interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<div
  class:list={[
    'flex flex-row items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-fd-accent hover:text-fd-accent-foreground [&_svg]:size-4',
    className,
  ]}
>
  {Astro.slots.has('icon') ? <slot name="icon" /> : <FileIcon />}
  {name}
</div>
