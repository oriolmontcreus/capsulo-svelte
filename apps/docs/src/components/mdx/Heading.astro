---
import Icon from '@/components/Icon.astro';

interface Props {
  as: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  id?: string;
  class?: string;
}

// Fumadocs' Heading: the text links to its own anchor, with a link icon on hover.
const { as: Tag, id, class: className, ...rest } = Astro.props;
---

{
  id ? (
    <Tag id={id} class:list={['flex scroll-m-28 flex-row items-center gap-2', className]} {...rest}>
      <a data-card="" href={`#${id}`} class="peer">
        <slot />
      </a>
      <Icon
        name="Link"
        aria-label="Link to section"
        class="size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100"
      />
    </Tag>
  ) : (
    <Tag class={className} {...rest}>
      <slot />
    </Tag>
  )
}
