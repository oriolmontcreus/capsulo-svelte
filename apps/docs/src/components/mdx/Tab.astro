---
import { escapeTabValue } from './tabs';

interface Props {
  value: string;
  class?: string;
}
const { value, class: className } = Astro.props;
---

<div
  role="tabpanel"
  data-tab-value={escapeTabValue(value)}
  data-state="inactive"
  class:list={[
    'p-4 text-[15px] bg-fd-background rounded-xl outline-none prose-no-margin data-[state=inactive]:hidden [&>figure:only-child]:-m-4 [&>figure:only-child]:border-none',
    className,
  ]}
>
  <slot />
</div>
