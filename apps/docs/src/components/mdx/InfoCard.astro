---
// InfoCard from the old docs (capsulo-docs/src/components/info-cards.tsx).
interface Props {
  title: string;
  description?: string;
  image?: string;
  href?: string;
  class?: string;
}

const { title, description, image, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  data-card
  class:list={[
    'block rounded-none border bg-fd-card p-4 text-fd-card-foreground transition-colors @max-lg:col-span-full',
    href && 'hover:bg-fd-accent/80',
    className,
  ]}
>
  {
    image && (
      <div class="not-prose mb-2 w-full h-40 overflow-hidden rounded-none">
        <img src={image} draggable="false" alt={title} class="w-full h-full object-cover select-none" />
      </div>
    )
  }
  <h3 class="not-prose mb-1 text-sm font-medium mt-6!">{title}</h3>
  {description && <p class="!my-0 text-sm text-fd-muted-foreground">{description}</p>}
  <div class="text-sm text-fd-muted-foreground prose-no-margin empty:hidden"><slot /></div>
</Tag>
