---
import Icon from '@/components/Icon.astro';
import type { DocPage } from '@/lib/page-tree';

interface Props {
  previous?: DocPage;
  next?: DocPage;
}

const { previous, next } = Astro.props;
const items = [previous && { item: previous, index: 0 }, next && { item: next, index: 1 }].filter(
  (value): value is { item: DocPage; index: number } => Boolean(value),
);
---

<div class:list={['@container grid gap-4 pb-6', previous && next ? 'grid-cols-2' : 'grid-cols-1']}>
  {
    items.map(({ item, index }) => (
      <a
        href={item.url}
        class:list={[
          'flex flex-col gap-2 rounded-lg border p-4 text-sm transition-colors hover:bg-fd-accent/80 hover:text-fd-accent-foreground @max-lg:col-span-full',
          index === 1 && 'text-end',
        ]}
      >
        <div class:list={['inline-flex items-center gap-1.5 font-medium', index === 1 && 'flex-row-reverse']}>
          <Icon name={index === 0 ? 'ChevronLeft' : 'ChevronRight'} class="-mx-1 size-4 shrink-0 rtl:rotate-180" />
          <p>{item.name}</p>
        </div>
        <p class="text-fd-muted-foreground truncate">
          {item.description ?? (index === 0 ? 'Previous Page' : 'Next Page')}
        </p>
      </a>
    ))
  }
</div>
