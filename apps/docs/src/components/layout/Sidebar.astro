---
import Icon from '@/components/Icon.astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import SidebarTree from './SidebarTree.astro';
import SearchToggle from './SearchToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { DocNode } from '@/lib/page-tree';
import { ghostIconButton } from '@/lib/classes';
import { site } from '@/lib/site';

interface Props {
  tree: DocNode[];
  currentUrl: string;
}

const { tree, currentUrl } = Astro.props;

const viewportStyle =
  '--sidebar-item-offset:calc(var(--spacing) * 2);mask-image:linear-gradient(to bottom, transparent, white 12px, white calc(100% - 12px), transparent)';
---

<!-- Floating controls shown while the desktop sidebar is collapsed -->
<div
  class="fixed flex shadow-lg transition-opacity rounded-xl p-0.5 border bg-fd-muted text-fd-muted-foreground z-10 max-md:hidden xl:start-4 max-xl:end-4 sidebar-expanded:pointer-events-none sidebar-expanded:opacity-0"
  style="top:calc(var(--fd-banner-height) + var(--fd-tocnav-height) + var(--spacing) * 4)"
>
  <button
    type="button"
    aria-label="Collapse Sidebar"
    data-sidebar-collapse
    class={ghostIconButton({ rounded: 'rounded-lg' })}
  >
    <Icon name="Sidebar" />
  </button>
  <SearchToggle rounded="rounded-lg" />
</div>

<!-- Desktop sidebar -->
<aside
  id="nd-sidebar"
  class="fixed left-0 rtl:left-auto rtl:right-(--removed-body-scroll-bar-size,0) flex flex-col items-end top-(--fd-sidebar-top) bottom-(--fd-sidebar-margin) z-20 bg-fd-card text-sm border-e transition-[top,opacity,translate,width] duration-200 max-md:hidden *:w-(--fd-sidebar-width) sidebar-collapsed:rounded-xl sidebar-collapsed:border sidebar-collapsed:translate-x-(--fd-sidebar-offset) sidebar-collapsed:rtl:-translate-x-(--fd-sidebar-offset) sidebar-collapsed:not-data-hover:opacity-0 sidebar-collapsed:data-hover:z-50 sidebar-collapsed:data-hover:shadow-lg"
>
  <div class="flex flex-col gap-3 p-4 pb-2">
    <div class="flex">
      <a class="inline-flex text-[15px] items-center gap-2.5 font-medium me-auto" href="/docs/">{site.title}</a>
      <button
        type="button"
        aria-label="Collapse Sidebar"
        data-sidebar-collapse
        class:list={[ghostIconButton(), 'mb-auto text-fd-muted-foreground']}
      >
        <Icon name="Sidebar" />
      </button>
    </div>
    <SearchToggle variant="full" />
  </div>
  <div class="overflow-hidden h-full relative">
    <div
      class="size-full rounded-[inherit] p-4 overscroll-contain overflow-y-auto fd-scroll-container"
      style={viewportStyle}
      data-sidebar-viewport
    >
      <div style="min-width:100%;display:table">
        <SidebarTree nodes={tree} currentUrl={currentUrl} />
      </div>
    </div>
  </div>
  <div class="flex flex-col border-t p-4 pt-2">
    <div class="flex text-fd-muted-foreground items-center empty:hidden">
      <a href={site.githubUrl} class={ghostIconButton()} aria-label="GitHub" data-active="false">
        <GitHubIcon />
      </a>
      <ThemeToggle class="ms-auto p-0" />
    </div>
  </div>
</aside>

<!-- Mobile sidebar (drawer from the right) -->
<div
  data-state="closed"
  data-sidebar-overlay
  hidden
  class="fixed z-40 inset-0 backdrop-blur-xs data-[state=open]:animate-fd-fade-in data-[state=closed]:animate-fd-fade-out md:hidden"
>
</div>
<aside
  id="nd-sidebar-mobile"
  data-state="closed"
  hidden
  class="fixed text-[15px] flex flex-col shadow-lg border-s end-0 inset-y-0 w-[85%] max-w-[380px] z-40 bg-fd-background data-[state=open]:animate-fd-sidebar-in data-[state=closed]:animate-fd-sidebar-out md:hidden"
>
  <div class="flex flex-col gap-3 p-4 pb-2">
    <div class="flex text-fd-muted-foreground items-center gap-1.5">
      <div class="flex flex-1">
        <a href={site.githubUrl} class={ghostIconButton({ padding: 'p-2' })} aria-label="GitHub">
          <GitHubIcon />
        </a>
      </div>
      <ThemeToggle class="p-0" />
      <button aria-label="Open Sidebar" data-sidebar-toggle class={ghostIconButton({ padding: 'p-2' })}>
        <Icon name="Sidebar" />
      </button>
    </div>
  </div>
  <div class="overflow-hidden h-full relative">
    <div
      class="size-full rounded-[inherit] p-4 overscroll-contain overflow-y-auto fd-scroll-container"
      style={viewportStyle}
    >
      <div style="min-width:100%;display:table">
        <SidebarTree nodes={tree} currentUrl={currentUrl} />
      </div>
    </div>
  </div>
</aside>
