---
import { icons, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  class?: string;
  fill?: string;
  [attr: string]: unknown;
}

const { name, class: className, fill = 'none', ...rest } = Astro.props;
// Inner SVG markup; attribute values are fixed strings from lib/icons.ts.
const inner = icons[name]
  .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).map(([key, value]) => `${key}="${value}"`).join(' ')}></${tag}>`)
  .join('');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill={fill}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['lucide', className]}
  {...rest}
>
  <Fragment set:html={inner} />
</svg>
