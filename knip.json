{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreIssues": {
    "src/lib/components/ui/**/index.ts": [
      "exports",
      "types",
      "enumMembers"
    ],
    "packages/capsulo/src/lib/components/ui/**/index.ts": [
      "exports",
      "types",
      "enumMembers"
    ]
  },
  "workspaces": {
    ".": {
      "entry": [
        "capsulo.config.ts",
        "src/components/capsules/**/capsule.definition.ts",
        "src/config/**/*.ts",
        "src/styles/**/*.css"
      ],
      "project": [
        "src/**/*.{ts,tsx,svelte,astro}"
      ]
    },
    "packages/capsulo": {
      "entry": [
        "bin/*.js",
        "scripts/*.js",
        "test/*.test-manual.js",
        "test/*.mjs",
        "src/**/*.test-manual.ts",
        "src/components/*.astro",
        "src/routes/**/*.{astro,ts}",
        "src/styles/**/*.css",
        "src/lib/form-builder/demo/**/*.{ts,svelte}",
        "src/lib/form-builder/core/schema-to-zod.ts",
        "src/lib/form-builder/schemas/**/*.ts",
        "src/lib/globals/empty-globals.schema.ts"
      ],
      "project": [
        "src/**/*.{ts,js,svelte,astro}",
        "cli/**/*.js"
      ],
      "ignore": [
        "src/lib/components/ui/dropdown-menu/**"
      ]
    },
    "packages/create-capsulo": {
      "entry": [
        "bin/*.js"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/pages/**/*.{astro,ts}",
        "src/scripts/*.ts",
        "src/previews/mock-*.ts",
        "src/styles/**/*.css",
        "src/previews/example-globals.schema.ts"
      ],
      "project": [
        "src/**/*.{ts,astro}"
      ],
      "ignoreDependencies": [
        "postcss-selector-parser",
        "bits-ui"
      ]
    }
  },
  "ignoreDependencies": [
    "cloudflare"
  ],
  "ignoreBinaries": [
    "tar"
  ]
}
