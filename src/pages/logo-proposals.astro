---
import Layout from "$/layouts/Layout.astro";
import {
	LOGO_INK_DARK,
	LOGO_INK_LIGHT,
	LOGO_VIEWBOX,
	logoProposals,
	standaloneSvg,
} from "$lib/brand/logo-proposals";

// Temporary page: brand mark exploration. Delete once a logo is chosen.

const SIZES = [16, 24, 32, 48];
const tiles = [
	{ label: "Light", bg: "#FFFFFF", ink: LOGO_INK_LIGHT },
	{ label: "Dark", bg: "#000000", ink: LOGO_INK_DARK },
];

const dataUri = (svg: string) => `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;

const cards = logoProposals.map((proposal, i) => ({
	...proposal,
	number: String(i + 1).padStart(2, "0"),
	downloads: [
		{ label: "Light bg", file: `${proposal.id}-light.svg`, svg: standaloneSvg(proposal, LOGO_INK_LIGHT) },
		{ label: "Dark bg", file: `${proposal.id}-dark.svg`, svg: standaloneSvg(proposal, LOGO_INK_DARK) },
		{ label: "Adaptive", file: `${proposal.id}.svg`, svg: standaloneSvg(proposal) },
	],
}));
---

<Layout>
	<main class="min-h-full bg-background-inset text-foreground">
		<div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-12 sm:px-6">
			<header class="flex flex-col gap-2">
				<span class="text-sm font-medium text-foreground-muted">Temporary · Brand exploration</span>
				<h1 class="text-3xl tracking-tight text-balance sm:text-4xl">Capsulo logo proposals</h1>
				<p class="max-w-[65ch] text-foreground-muted text-balance">
					{logoProposals.length} square, text-free marks. Each one is shown on white and black, and at 16, 24, 32 and 48 px to check it still reads as a favicon. Neutral shapes follow the background; the accent is always Svelte orange.
				</p>
			</header>

			<ol class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
				{cards.map((card) => (
					<li id={card.id} class="flex flex-col overflow-hidden rounded-xl border border-border bg-background">
						<div class="grid grid-cols-2">
							{tiles.map((tile) => (
								<div class="flex flex-col items-center gap-5 px-4 pt-7 pb-5" style={`background:${tile.bg};color:${tile.ink}`}>
									<svg viewBox={LOGO_VIEWBOX} class="size-24" role="img" aria-label={`${card.name} on ${tile.label.toLowerCase()} background`} set:html={card.svg} />
									<div class="flex items-end gap-3">
										{SIZES.map((size) => (
											<svg viewBox={LOGO_VIEWBOX} width={size} height={size} aria-hidden="true" set:html={card.svg} />
										))}
									</div>
								</div>
							))}
						</div>

						<div class="flex flex-1 flex-col gap-4 p-5">
							<div class="flex flex-col gap-1.5">
								<h2 class="flex items-baseline gap-2 text-lg">
									<span class="text-sm tabular-nums text-foreground-muted">{card.number}</span>
									{card.name}
								</h2>
								<p class="text-sm text-foreground-muted">{card.concept}</p>
							</div>

							<div class="mt-auto flex flex-wrap gap-2">
								{card.downloads.map((d) => (
									<a
										href={dataUri(d.svg)}
										download={d.file}
										class="rounded-sm border border-border px-2.5 py-1 text-xs font-medium text-foreground-muted transition-colors hover:bg-background-muted hover:text-foreground"
									>
										{d.label} SVG
									</a>
								))}
								<button
									type="button"
									data-copy-svg={card.downloads[2].svg}
									class="rounded-sm border border-border px-2.5 py-1 text-xs font-medium text-foreground-muted transition-colors hover:bg-background-muted hover:text-foreground"
								>
									Copy
								</button>
							</div>
						</div>
					</li>
				))}
			</ol>
		</div>
	</main>
</Layout>

<script>
	function bindCopyButtons() {
		document.querySelectorAll<HTMLButtonElement>("[data-copy-svg]").forEach((button) => {
			button.onclick = async () => {
				try {
					await navigator.clipboard.writeText(button.dataset.copySvg ?? "");
					button.textContent = "Copied";
				} catch {
					button.textContent = "Copy failed";
				}
				setTimeout(() => (button.textContent = "Copy"), 1500);
			};
		});
	}
	bindCopyButtons();
	document.addEventListener("astro:page-load", bindCopyButtons);
</script>
