---
import Layout from "./Layout.astro";
import AdminNav from "$lib/admin/AdminNav.svelte";
import { ScrollArea } from "$lib/components/ui/scroll-area";

interface Props {
	activeRoute: "page-editor" | "globals" | "changes" | "history";
	scrollable?: boolean;
}

const { activeRoute, scrollable = true } = Astro.props as Props;
---

<Layout fontFamily="geist">
	<script is:inline>
		// Admin pages are static; the API is the security boundary. This only avoids
		// flashing the editor to someone who is not signed in (the hint cookie is set
		// next to the HttpOnly session cookie and carries no secret).
		if (!document.cookie.split("; ").some((cookie) => cookie.startsWith("capsulo_signed_in="))) {
			location.replace("/admin/login?next=" + encodeURIComponent(location.pathname + location.search));
		}
	</script>
	<div class="flex h-dvh w-full overflow-hidden bg-neutral-100 dark:bg-[oklch(0.205_0_0)]">
		<AdminNav {activeRoute} client:load transition:persist="admin-nav" />
		<div class="min-h-0 min-w-0 flex-1 overflow-hidden">
			{scrollable ? (
				<ScrollArea class="h-full w-full" client:load>
					<slot />
				</ScrollArea>
			) : (
				<div class="h-full min-h-0">
					<slot />
				</div>
			)}
		</div>
	</div>
</Layout>
