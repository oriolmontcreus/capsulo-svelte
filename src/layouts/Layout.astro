---
import "../styles/global.css";
import CmsPump from "$lib/cms/CmsPump.svelte";
import ModeWatcherClient from "$lib/components/ModeWatcherClient.svelte";
import { getLocaleFromPathname } from "$lib/i18n/routing";
import { PUBLISHED_ELEMENT_ID, getPublishedValues } from "$lib/cms/published";
import { ClientRouter } from "astro:transitions";

interface Props {
	fontFamily?: "sans" | "geist";
}

const { fontFamily = "sans" } = Astro.props as Props;
const locale = getLocaleFromPathname(Astro.url.pathname);

// Published CMS values for this page (seeded by src/middleware.ts), embedded for hydration.
const isAdminPage = Astro.url.pathname.startsWith("/admin");
const publishedValues = isAdminPage ? {} : getPublishedValues();
const publishedJson =
	Object.keys(publishedValues).length > 0 ? JSON.stringify(publishedValues).replaceAll("<", "\\u003c") : null;
---

<!doctype html>
<html lang={locale} class={fontFamily === "geist" ? "font-geist" : "font-sans"} transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<ClientRouter fallback="swap" />
		<script is:inline>
			(function() {
				function applyMode() {
					try {
						const mode = localStorage.getItem("mode-watcher-mode") || "system";
						const light = mode === "light" || (mode === "system" && window.matchMedia("(prefers-color-scheme: light)").matches);
						const rootEl = document.documentElement;
						if (light) {
							rootEl.classList.remove("dark");
						} else {
							rootEl.classList.add("dark");
						}
						rootEl.style.colorScheme = light ? "light" : "dark";
					} catch (e) {}
				}
				applyMode();
				// The ClientRouter swap copies <html> attributes from the incoming page, which is
				// rendered without the theme class. Carry it over before the swap so persisted
				// elements (e.g. the theme toggle icon) never see the class drop and re-animate.
				document.addEventListener("astro:before-swap", (event) => {
					const current = document.documentElement;
					const next = event.newDocument.documentElement;
					next.classList.toggle("dark", current.classList.contains("dark"));
					next.style.colorScheme = current.style.colorScheme;
				});
				document.addEventListener("astro:after-swap", applyMode);
			})();
		</script>
	</head>
	<body>
		{publishedJson && <script is:inline type="application/json" id={PUBLISHED_ELEMENT_ID} set:html={publishedJson} />}
		<slot />
		<CmsPump client:load />
		<ModeWatcherClient client:load transition:persist="mode-watcher" />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
