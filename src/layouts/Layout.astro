---
import "../styles/global.css";
import CmsPump from "$lib/cms/CmsPump.svelte";
import ModeWatcherClient from "$lib/components/ModeWatcherClient.svelte";
import { getLocaleFromPathname } from "$lib/i18n/routing";
import { PUBLISHED_ELEMENT_ID, getPublishedValues, getPublishedVariables } from "$lib/cms/published";
import { ClientRouter } from "astro:transitions";

interface Props {
	fontFamily?: "sans" | "geist";
}

const { fontFamily = "sans" } = Astro.props as Props;
const locale = getLocaleFromPathname(Astro.url.pathname);

// Published CMS values and global variables for this page (seeded by src/middleware.ts),
// embedded so islands hydrate with the same text the build rendered.
const isAdminPage = Astro.url.pathname.startsWith("/admin");
const values = isAdminPage ? {} : getPublishedValues();
const variables = isAdminPage ? {} : getPublishedVariables();
const publishedJson =
	Object.keys(values).length > 0 || Object.keys(variables).length > 0
		? JSON.stringify({ values, variables }).replaceAll("<", "\\u003c")
		: null;
---

<!doctype html>
<html lang={locale} class={fontFamily === "geist" ? "font-geist" : "font-sans"} transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<ClientRouter fallback="swap" />
		<script is:inline>
			(function() {
				function applyMode(rootEl) {
					try {
						const mode = localStorage.getItem("mode-watcher-mode") || "system";
						const light = mode === "light" || (mode === "system" && window.matchMedia("(prefers-color-scheme: light)").matches);
						if (light) {
							rootEl.classList.remove("dark");
						} else {
							rootEl.classList.add("dark");
						}
						rootEl.style.colorScheme = light ? "light" : "dark";
					} catch (e) {}
				}
				applyMode(document.documentElement);
				// Set the mode on the incoming document before the router copies its <html>
				// attributes over. Re-adding it after the swap leaves a window where the page
				// is styled as light, and anything with a color transition fades in from white.
				document.addEventListener("astro:before-swap", (event) => applyMode(event.newDocument.documentElement));
			})();
		</script>
	</head>
	<body>
		{publishedJson && <script is:inline type="application/json" id={PUBLISHED_ELEMENT_ID} set:html={publishedJson} />}
		<slot />
		<CmsPump client:load />
		<ModeWatcherClient client:load transition:persist="mode-watcher" />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
