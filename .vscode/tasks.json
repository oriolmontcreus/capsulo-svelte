{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "run dev",
			"type": "shell",
			"command": "pnpm dev",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "Astro + the CMS API in workerd with a local D1/KV. Open http://localhost:4321/admin (signed in automatically).",
			"icon": {
				"id": "server-process",
				"color": "terminal.ansiBlue"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "astro",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "localhost:4321"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"showReuseMessage": false
			}
		}
	]
}
